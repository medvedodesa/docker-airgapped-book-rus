# syntax=docker/dockerfile:1
# Dockerfile.go-scratch — многоэтапная сборка Go-сервиса
# Этап 1: Go-компилятор со статической линковкой
# Этап 2: scratch-образ — только бинарник
#
# Использование:
#   docker build \
#     --build-arg NEXUS_URL=http://nexus.internal.company.local:8081 \
#     --build-arg HARBOR_URL=harbor.internal.company.local \
#     -f Dockerfile.go-scratch \
#     -t harbor.internal.company.local/myapp/service:1.0.0 .

ARG HARBOR_URL=harbor.internal.company.local
ARG NEXUS_URL=http://nexus.internal.company.local:8081
ARG GO_VERSION=1.22

# ══════════════════════════════════════════════════════
# ЭТАП 1: Сборка — Go-компилятор
# ══════════════════════════════════════════════════════
FROM ${HARBOR_URL}/library/golang:${GO_VERSION}-alpine AS builder

ARG NEXUS_URL
ARG APP_VERSION=0.0.1
ARG BUILD_DATE
ARG GIT_COMMIT

# GOPROXY — только внутренний Athens или Nexus, затем off (никакого интернета)
ENV GOPROXY=${NEXUS_URL}/repository/go-proxy/,off
ENV GONOSUMCHECK=*
ENV GOFLAGS=-mod=mod
ENV CGO_ENABLED=0
ENV GOOS=linux
ENV GOARCH=amd64

WORKDIR /build

# Копируем только go.mod и go.sum — кешируем загрузку модулей
COPY go.mod go.sum ./
RUN go mod download && go mod verify

# Копируем исходный код и собираем статический бинарник
COPY . .
RUN go build \
    -ldflags="-s -w \
      -X main.Version=${APP_VERSION} \
      -X main.BuildDate=${BUILD_DATE} \
      -X main.GitCommit=${GIT_COMMIT} \
      -extldflags=-static" \
    -trimpath \
    -o /bin/service \
    ./cmd/server/

# Проверяем что бинарник действительно статический
RUN file /bin/service && \
    ldd /bin/service 2>&1 | grep -q "not a dynamic" || \
    (echo "ОШИБКА: бинарник динамически слинкован — проверьте CGO_ENABLED=0" && exit 1)

# Копируем CA-сертификаты для HTTPS-запросов приложения
RUN apk add --no-cache ca-certificates && \
    update-ca-certificates

# ══════════════════════════════════════════════════════
# ЭТАП 2: Рантайм — scratch (пустой образ)
# ══════════════════════════════════════════════════════
FROM scratch AS runtime

LABEL maintainer="team@company.local" \
      org.opencontainers.image.title="myapp-service" \
      org.opencontainers.image.description="Go-сервис, scratch-образ"

# Копируем только необходимое из этапа сборки
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /etc/passwd /etc/passwd
COPY --from=builder /bin/service /service

# Нет шелла, нет пакетного менеджера, нет системных утилит
# Злоумышленник не может выполнить интерактивную сессию

EXPOSE 8080

# В scratch нет curl для healthcheck — используем TCP-проверку или HTTP через бинарник
# HEALTHCHECK --interval=30s --timeout=3s \
#     CMD ["/service", "healthcheck"] || exit 1

# Запуск от UID 65534 (nobody) — в scratch нет /etc/passwd, UID задаётся напрямую
USER 65534

ENTRYPOINT ["/service"]
