{
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus"}],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""}
  ],
  "annotations": {"list": []},
  "description": "Планирование ёмкости: прогнозы исчерпания диска, памяти, CPU через predict_linear на 90 дней",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Диск",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 60},
            {"color": "red", "value": 80}
          ]},
          "unit": "days",
          "mappings": [{"options": {"match": "null", "result": {"text": "N/A"}}, "type": "special"}]
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "title": "Диск заполнится через (дни)",
      "type": "stat",
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "(node_filesystem_avail_bytes{mountpoint=\"/\", instance=~\"$instance\", fstype!=\"tmpfs\"} / abs(predict_linear(node_filesystem_avail_bytes{mountpoint=\"/\", instance=~\"$instance\", fstype!=\"tmpfs\"}[7d], 0) - node_filesystem_avail_bytes{mountpoint=\"/\", instance=~\"$instance\", fstype!=\"tmpfs\"})) / 86400",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "color": {"mode": "palette-classic"}}},
      "gridPos": {"h": 8, "w": 18, "x": 6, "y": 1},
      "id": 2,
      "options": {"tooltip": {"mode": "multi"}},
      "title": "Использование диска / (текущее + прогноз 90 дней)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\", instance=~\"$instance\", fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\", instance=~\"$instance\", fstype!=\"tmpfs\"})",
          "legendFormat": "{{instance}} (текущее)"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "100 * (1 - clamp_min(predict_linear(node_filesystem_avail_bytes{mountpoint=\"/\", instance=~\"$instance\", fstype!=\"tmpfs\"}[7d], 90*24*3600), 0) / node_filesystem_size_bytes{mountpoint=\"/\", instance=~\"$instance\", fstype!=\"tmpfs\"})",
          "legendFormat": "{{instance}} (прогноз 90д)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "id": 101,
      "title": "Память",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "color": {"mode": "palette-classic"}}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "id": 3,
      "options": {"tooltip": {"mode": "multi"}},
      "title": "Использование памяти + прогноз 30 дней",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"})",
          "legendFormat": "{{instance}} (текущее)"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "100 * (1 - clamp_min(predict_linear(node_memory_MemAvailable_bytes{instance=~\"$instance\"}[7d], 30*24*3600), 0) / node_memory_MemTotal_bytes{instance=~\"$instance\"})",
          "legendFormat": "{{instance}} (прогноз 30д)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "id": 102,
      "title": "CPU",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "color": {"mode": "palette-classic"}}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "id": 4,
      "options": {"tooltip": {"mode": "multi"}},
      "title": "Загрузка CPU + прогноз 30 дней",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\", instance=~\"$instance\"}[5m])) * 100)",
          "legendFormat": "{{instance}} (текущее)"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "clamp_max(predict_linear((100 - avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\", instance=~\"$instance\"}[5m]))*100)[7d:5m], 30*24*3600), 100)",
          "legendFormat": "{{instance}} (прогноз 30д)"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "tags": ["capacity", "planning", "infrastructure"],
  "templating": {
    "list": [{
      "current": {},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "definition": "label_values(node_uname_info, instance)",
      "hide": 0,
      "includeAll": true,
      "multi": true,
      "name": "instance",
      "query": "label_values(node_uname_info, instance)",
      "refresh": 2,
      "type": "query",
      "label": "Хост"
    }]
  },
  "time": {"from": "now-7d", "to": "now+90d"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Планирование ёмкости",
  "uid": "capacity-planning-airgap",
  "version": 1
}
